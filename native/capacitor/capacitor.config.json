{
  "appId": "com.amazecc.app",
  "appName": "AmazeCC",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#f7f1e6"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#004643",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#004643"
    },
    "LocalNotifications": {
      "iconColor": "#004643"
    }
  }
}
