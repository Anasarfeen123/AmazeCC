{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AmazeCC",
  "version": "0.1.0",
  "identifier": "com.amazecc.desktop",
  "build": {
    "frontendDist": "../../../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AmazeCC",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Attendance, marks, timetable and campus tools for VIT Chennai",
    "longDescription": "AmazeCC is a student-made app for VIT Chennai: attendance with skip predictions, marks, grades, timetable, exams, FFCS planner and campus tools, in one place.",
    "copyright": "Amaze Continuity Projects",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2ODY4RThFOTlENzRBNkEKUldScVN0ZVpqbzZHaHJsaGJ0enVud2M4R09yZXNxNTYwRmVrNkRyd2N1dXM2ay8wU0VXeXF6VU8K",
      "endpoints": [
        "https://github.com/Anasarfeen123/AmazeCC/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
