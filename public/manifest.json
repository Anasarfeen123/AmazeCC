{
    "id": "/",
    "name": "AmazeCC",
    "short_name": "AmazeCC",
    "description": "Timetable, attendance, marks and grades for VIT Chennai students, in one app that works offline.",
    "lang": "en",
    "categories": [
        "education",
        "productivity"
    ],
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "background_color": "#001E1D",
    "theme_color": "#004643",
    "shortcuts": [
        {
            "name": "Timetable",
            "short_name": "Timetable",
            "description": "Today's classes and the calendar",
            "url": "./?tab=timetable&source=shortcut",
            "icons": [
                {
                    "src": "./brand/shortcuts/timetable.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Marks",
            "short_name": "Marks",
            "description": "Your courses and marks this semester",
            "url": "./?tab=marks&source=shortcut",
            "icons": [
                {
                    "src": "./brand/shortcuts/marks.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Grade History",
            "short_name": "Grades",
            "description": "Every term's grades and CGPA",
            "url": "./?tab=grades&source=shortcut",
            "icons": [
                {
                    "src": "./brand/shortcuts/grades.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Exam Schedule",
            "short_name": "Exams",
            "description": "Upcoming exams and seats",
            "url": "./?tab=exams&source=shortcut",
            "icons": [
                {
                    "src": "./brand/shortcuts/exams.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    ],
    "share_target": {
        "action": "./share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "images",
                    "accept": [
                        "image/*"
                    ]
                }
            ]
        }
    },
    "icons": [
        {
            "src": "./favicon/web-app-manifest-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./favicon/web-app-manifest-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./brand/maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "./brand/maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "orientation": "any",
    "gcm_sender_id": "103953800507",
    "display_override": [
        "standalone",
        "minimal-ui"
    ],
    "launch_handler": {
        "client_mode": [
            "focus-existing",
            "auto"
        ]
    },
    "prefer_related_applications": false,
    "screenshots": [
        {
            "src": "./brand/screens/home-phone.webp",
            "sizes": "390x900",
            "type": "image/webp",
            "form_factor": "narrow",
            "label": "Home: attendance, today's classes and the mess menu"
        },
        {
            "src": "./brand/screens/home-desktop.webp",
            "sizes": "1280x900",
            "type": "image/webp",
            "form_factor": "wide",
            "label": "Home on a laptop, with the sidebar"
        }
    ]
}
